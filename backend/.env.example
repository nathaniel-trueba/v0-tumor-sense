# Copy to backend/.env and fill in. All values are optional.

# Enable the OpenAI-backed RAG generator. If unset, /api/explain falls back to
# a deterministic template generator that still retrieves passages but writes
# the prose itself (no API key needed).
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed CORS origins. Defaults to "*" for dev.
# TUMORSENSE_CORS_ORIGINS=http://localhost:3000

# Override the model / document directories (defaults to ./models and ./documents).
# TUMORSENSE_MODELS_DIR=
# TUMORSENSE_DOCUMENTS_DIR=
